# DeepSeek 开放平台 https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 大纲分栏页填充默认用 deepseek-reasoner（前端 STRONG_LLM_MODEL）；须为账号可用的 deepseek-* 名

# Embedding（本地 sentence-transformers）
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cuda
# 模型缓存目录由 start.sh 设置：HF_HOME=$HOME/models/huggingface（与 docuMind 共用，勿在项目内再拷一份）

# 检索模式：hybrid（向量+BM25）| vector | bm25
RETRIEVAL_MODE=hybrid

# 向量余弦门槛。无关文本多在 0.45 以下，相关多在 0.6 以上。
DEFAULT_SCORE_THRESHOLD=0.5
# 大纲 / 正文：向量召回条数、每段引号专名、第二跳专名个数与候选条数、专名余弦门槛、送进模型的片段上限
WRITING_VECTOR_TOP_K=12
WRITING_QUOTE_PER_CHUNK=3
WRITING_NAME_LIMIT=8
WRITING_NAME_TOP_K=3
WRITING_NAME_SCORE_THRESHOLD=0
WRITING_CONTEXT_LIMIT=14

# 服务
HOST=0.0.0.0
PORT=7861
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

DATA_DIR=./data

# OCR（扫描件/图表混排 PDF）
OCR_ENABLED=true
OCR_ENGINE=paddleocr_vl
OCR_VL_PIPELINE_VERSION=v1.5
OCR_VL_ENGINE=transformers
OCR_MIN_CHARS_PER_PAGE=40
OCR_DPI_SCALE=2.0
OCR_FORCE_ALL_PAGES=false

# 反馈闭环 · 邮件通知（可选；整段留空则跳过发信，不影响闭环）
# 465=SSL（smtplib.SMTP_SSL） / 587=STARTTLS（smtplib.SMTP + starttls）
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password-or-auth-code
SMTP_FROM=you@example.com
# 状态变更直达链接的站点根地址（如 http://localhost:8000）
FEEDBACK_SITE_BASE=http://localhost:8000

# 全站鉴权守卫：off | log | enforce（默认 enforce）
AUTH_GUARD_MODE=enforce
# 可信反向代理（仅这些 peer 才采信 X-Real-IP / X-Forwarded-For）
TRUSTED_PROXIES=127.0.0.1,::1

# 可选：首次建库时的 admin 初始密码；缺省随机写入 data/initial_admin.txt
# BIFANG_SEED_ADMIN_PASSWORD=
# 可选：启动时重置已有 admin 密码并标记强改（用完请删）
# BIFANG_RESET_ADMIN_PASSWORD=
